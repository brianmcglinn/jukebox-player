# Same HERMES self-hosted instance/anon key you already use for jeopardy_app —
# this app is just a different schema on the same Postgres, same Kong gateway.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.X:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-self-hosted-anon-key
EXPO_PUBLIC_PLEX_SERVER_URL=http://192.168.1.X:32400
EXPO_PUBLIC_PLEX_TOKEN=your-plex-token
EXPO_PUBLIC_YT_API_KEY=your-youtube-data-api-key
# Shown as a QR code on the idle screen so guests can add songs from their own phone
EXPO_PUBLIC_MOBILE_APP_URL=https://mcglinnjukebox.app
